{
  "configVersion": "0.58.1",
  "branchPattern": "feature/<id>-<description>",
  "stack": {
    "backend": "go-bubbletea",
    "frontend": null,
    "testing": [
      "go-test"
    ]
  },
  "guidanceLocation": "AGENTS.md",
  "mcpServers": {
    "context7": true
  },
  "lspServers": {
    "gopls": true,
    "pyright": true
  },
  "autoCompactDisabled": true,
  "pinSubagents200K": false,
  "cicd": {
    "enabled": true,
    "platform": "github-actions"
  },
  "sandbox": {
    "enabled": true,
    "baseVersion": null
  },
  "lazyboards": {
    "enabled": true,
    "serveCommand": "go run .",
    "boardKey": "S",
    "testCommand": "go test ./...",
    "testKey": "T"
  }
}
