{
  "configVersion": "0.58.1",
  "branchPattern": "feature/<id>-<description>",
  "stack": {
    "backend": "go-bubbletea",
    "frontend": null,
    "testing": [
      "go-test"
    ]
  },
  "guidanceLocation": "AGENTS.md",
  "mcpServers": {
    "context7": true
  },
  "lspServers": {
    "gopls": true,
    "pyright": true
  },
  "autoCompactDisabled": true,
  "pinSubagents200K": false,
  "cicd": {
    "enabled": true,
    "platform": "github-actions"
  },
  "sandbox": {
    "enabled": true,
    "baseVersion": null
  },
  "lazyboards": {
    "enabled": true,
    "serveCommand": "go run .",
    "boardKey": "S",
    "testCommand": "go test ./...",
    "testKey": "T"
  },
  "planning": {
    "autonomy": "lean"
  },
  "automerge": {
    "protectedPaths": [
      "*auth*",
      "*login*",
      "*logout*",
      "*session*",
      "*password*",
      "*passwd*",
      "*credential*",
      "*secret*",
      "*secrets*",
      "*token*",
      "*jwt*",
      "*apikey*",
      "*api_key*",
      "*.pem",
      "*.key",
      "*.env*",
      "*oauth*",
      "*sso*",
      "*saml*",
      "*openid*",
      "*permission*",
      "*acl*",
      "*rbac*",
      "*role*",
      "*crypto*",
      "*encrypt*",
      "*decrypt*",
      "*sign*",
      "*hash*",
      "*payment*",
      "*billing*",
      "*invoice*",
      "*checkout*",
      "*stripe*",
      "*migrat*",
      "*schema*",
      ".github/",
      ".cenci/"
    ],
    "maxChangedFiles": 10,
    "maxDiffLines": 400,
    "mergeMethod": "squash"
  }
}
